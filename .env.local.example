# 이 파일을 복사해서 `.env.local` 로 이름을 바꾼 뒤 값을 채우세요. (.env.local 은 GitHub에 올라가지 않아요)
# 복사: PowerShell에서  Copy-Item .env.local.example .env.local

# Supabase 프로젝트: sshh (ID: rfbskrwulxhkcaeiwhgi)
# 값 찾는 곳: https://supabase.com/dashboard/project/rfbskrwulxhkcaeiwhgi/settings/api
#   (왼쪽 아래 Project Settings → API / API Keys)

# 프로젝트 주소 — "Project URL" (브라우저에 공개돼도 괜찮은 값)
NEXT_PUBLIC_SUPABASE_URL=https://rfbskrwulxhkcaeiwhgi.supabase.co

# 공개용 키 — "anon public" 키 (또는 새 화면의 "Publishable key", sb_publishable_... 로 시작)
# 브라우저에 공개돼도 괜찮지만, 데이터는 RLS(행 보안 정책)로 지켜야 해요.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ⚠ 서버 전용 키 — "service_role" 키 (새 화면의 "Secret key", sb_secret_... 로 시작)
# RLS를 무시하는 만능 키예요. 절대 NEXT_PUBLIC_ 을 붙이지 말고, 브라우저 코드·GitHub·채팅에 올리지 마세요.
# 지금 단계(로그인)에서는 필요 없으니 비워 둬도 돼요. 서버에서 관리 작업이 필요해질 때 채웁니다.
SUPABASE_SERVICE_ROLE_KEY=
