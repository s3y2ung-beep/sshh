# 이 파일을 복사해서 `.env.local` 로 이름을 바꾼 뒤 값을 채우세요. (.env.local 은 GitHub에 올라가지 않아요)
# 복사: PowerShell에서  Copy-Item .env.local.example .env.local
#
# ⚠ 값은 이 파일(.example)이 아니라 .env.local 에만 적으세요. 비밀 키를 채팅·GitHub·스크린샷에 올리지 마세요.
# ⚠ Windows PowerShell 5.1에서 값을 `|`(파이프)로 다른 명령에 넘기면 보이지 않는 문자(BOM)가 붙어 키가 망가져요.

# ───────── Supabase (Project Settings → API) ─────────
# 프로젝트 주소 — "Project URL" (브라우저에 공개돼도 괜찮은 값)
NEXT_PUBLIC_SUPABASE_URL=

# 공개용 키 — "anon public" 키 (또는 "Publishable key", sb_publishable_... 로 시작)
# 브라우저에 공개돼도 괜찮지만, 데이터는 RLS(행 보안 정책)로 지켜져요.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ⚠ 서버 전용 키 — "service_role" 키 (또는 "Secret key", sb_secret_... 로 시작)
# RLS를 무시하는 만능 키예요. 절대 NEXT_PUBLIC_ 을 붙이지 마세요.
# 쓰는 곳: 확인 질문의 비밀 정답 비교(app/api/items/[id]/verify). 비워 두면 확인 질문이 있는 글에 연락할 수 없어요.
SUPABASE_SERVICE_ROLE_KEY=

# ───────── 카카오 (https://developers.kakao.com → 내 애플리케이션 → 앱 키) ─────────
# 서버 전용 — "REST API 키". 좌표→주소 변환, 장소·주소 검색에 써요.
KAKAO_REST_API_KEY=
# 공개용 — "JavaScript 키". 지도 화면에 써요. 카카오 앱의 [플랫폼 → Web]에 사이트 도메인을 꼭 등록하세요
# (예: http://localhost:3000 과 배포 주소). 등록한 도메인에서만 동작해서 브라우저에 공개돼도 괜찮아요.
NEXT_PUBLIC_KAKAO_JS_KEY=

# ───────── OpenAI (https://platform.openai.com/api-keys) ─────────
# 서버 전용 — 사진 분석·글 작성·대화·확인 질문 채점에 써요.
OPENAI_API_KEY=
# (선택) 쓸 모델 이름. 비우면 gpt-5.4-mini
OPENAI_MODEL=